<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.zcy.finance</groupId>
    <artifactId>finance-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>finance-service</name>
    <description>Demo finance Dubbo service modules</description>

    <modules>
        <module>finance-api</module>
        <module>finance-infra</module>
        <module>finance-core</module>
        <module>finance-starter</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <dubbo.version>3.1.12.9</dubbo.version>
        <dubbo.spring.boot.version>3.1.8.8</dubbo.spring.boot.version>
